# ---- Live rezultati (opcionalno) ----
# Lakše je zalijepiti API-Football ključ u samoj aplikaciji (gore desno → Live).
# Server-side varijanta (npr. na Vercelu): postavi WC_API_KEY.
WC_API_KEY=

# ---- Nalozi + sinhronizacija (opcionalno, Supabase) ----
# Bez ovih, aplikacija radi normalno samo lokalno (localStorage), bez prijave.
# Dobiješ ih na supabase.com → Project Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
