# Opcionalno: API-Football ključ za live rezultate.
# Lakše je zalijepiti ključ direktno u aplikaciji (gore desno → Live),
# ali ako želiš da ključ stoji server-side, kopiraj ovaj fajl u ".env" i upiši ključ:
#
#   WC_API_KEY=tvoj_kljuc_ovdje
#
# Ključ dobiješ besplatnom registracijom na https://dashboard.api-football.com
WC_API_KEY=
